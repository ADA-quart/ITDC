<?xml version="1.0" encoding="utf-8"?>
<!-- 「倒计时」条目（横扁：4×1 / 横屏 5×2 等，宽 ≥ 1.9×高 或高度不足 120dp 时启用）：
     左栏大数字 + 单位，右栏目标详情。id 与纵向布局完全一致，
     渲染逻辑见 ITDCWidgetProvider.renderCountdown（按格子比例切换布局）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_tint"
    android:clipToOutline="true">

    <!-- 用户自定义背景层：与主布局同名 id，复用同一套外观下发 -->
    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/countdown_num_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 内层只管基线对齐，外层的 center_vertical 不会干扰它 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/countdown_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:textSize="46sp"
                    android:textStyle="bold"
                    android:textColor="#FF4C9AFF"
                    android:text="67" />

                <TextView
                    android:id="@+id/countdown_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FF4C9AFF"
                    android:text="天" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/countdown_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:text="期末考试 还有" />

            <TextView
                android:id="@+id/countdown_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:text="10-20 09:00 开始" />

            <ImageView
                android:id="@+id/countdown_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/widget_divider"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/countdown_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="5dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:text="接下来：实验报告 · 3 天" />
        </LinearLayout>
    </LinearLayout>

    <!-- 空状态：整块盖住内容区居中显示 -->
    <TextView
        android:id="@+id/countdown_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="13.5sp"
        android:textColor="@color/widget_text_secondary"
        android:visibility="gone"
        android:text="暂无待办倒计时\n给待办加上时间或截止日期即可" />
</FrameLayout>
