# 统一行尾，避免 Windows/Linux 协作者之间产生整文件 diff
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则可能无法执行
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.jar binary
*.apk binary
*.keystore binary
*.jks binary

# 生成物不计入语言统计
package-lock.json linguist-generated=true
dist/** linguist-generated=true
