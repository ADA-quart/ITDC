# Backend port (default 3000)
PORT=3000

# LAN access host (default 0.0.0.0)
HOST=0.0.0.0

# 跨网络同步：额外放行的前端来源（逗号分隔，写完整协议+域名）。
# 云端部署时把前端域名填在这里，例如：
#   CORS_ORIGINS=https://itdc.example.com,https://itdc.pages.dev
# 纯自建/内网部署可设 CORS_ALLOW_ALL=1 放行任意来源（勿在公开公网服务上开启）。
CORS_ORIGINS=
CORS_ALLOW_ALL=

# Vite dev proxy target backend port (defaults to PORT)
BACKEND_PORT=3000

# AES-256-GCM secret for encrypting LLM API keys.
# Required in production — generate with: openssl rand -hex 32 or python -c "import secrets;print(secrets.token_hex(32))"
CRYPTO_SECRET=
# Path to the SQLite database file (default: <repo root>/data/calendar.db).
# Relative paths are resolved against the process working directory.
DB_PATH=
