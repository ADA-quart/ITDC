# 统一编辑器行为，避免不同 IDE 产生无意义的格式差异
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.{java,xml}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2
